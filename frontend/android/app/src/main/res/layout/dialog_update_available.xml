<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <!-- Version Subheading -->
    <TextView
        android:id="@+id/tvUpdateVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version 1.3.0"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- Section Header: What's New -->
    <TextView
        android:id="@+id/tvWhatsNewHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="What's New"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary" />

    <!-- Scrollable Release Notes -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="220dp"
        android:fadingEdge="vertical"
        android:requiresFadingEdge="vertical">

        <TextView
            android:id="@+id/tvReleaseNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="• Improved AI Proctoring\n• Faster report generation\n• Bug fixes" />
    </ScrollView>

</LinearLayout>
