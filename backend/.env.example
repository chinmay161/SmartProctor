AUTH0_DOMAIN=
AUTH0_API_AUDIENCE=
AUTH0_ISSUER=

AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_MGMT_AUDIENCE=

# JWT and Security
SECRET_KEY=
JWT_ALGORITHM=

# Database
DATABASE_URL=

# Access token expiration (minutes)
# Short-lived token used for API requests
ACCESS_TOKEN_EXPIRE_MINUTES=

# Refresh token expiration (days)
# Users can refresh tokens within this window
REFRESH_TOKEN_EXPIRE_DAYS=

# Absolute refresh token expiration (days)
# Maximum time before user must login again
REFRESH_TOKEN_ABSOLUTE_EXPIRE_DAYS=

# Session inactivity timeout (minutes)
# Sessions expire if no activity for this duration
INACTIVITY_TIMEOUT_MINUTES=

# Maximum number of concurrent sessions per user
# Set to high number (e.g., 100) to effectively disable limit
MAX_SESSIONS_PER_USER=

# Maximum number of times a refresh token can be refreshed
# Forces re-authentication after limit is reached
MAX_REFRESH_COUNT=

# Require MFA for sensitive operations (true/false)
REQUIRE_MFA_FOR_SENSITIVE_OPS=

# Allow multiple simultaneous sessions per user (true/false)
# false = only one session per user (mobile only, tablet only, etc.)
# true = allow multiple sessions
ALLOW_CONCURRENT_SESSIONS=

# Allow login from different devices (true/false)
ALLOW_CROSS_DEVICE_LOGIN=

# Validate IP address on each request (true/false)
VALIDATE_IP_ADDRESS=

# Number of IP changes allowed before requiring re-authentication
ALLOWED_IP_CHANGES_PER_SESSION=

# Validate device fingerprint (true/false)
VALIDATE_DEVICE_FINGERPRINT=

# Track trusted devices for easier re-authentication (true/false)
TRACK_TRUSTED_DEVICES=

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=

# Enable verbose session logging for debugging
VERBOSE_SESSION_LOGGING=

# Frontend URL for redirects after logout
FRONTEND_URL=

# Allowed CORS origins
CORS_ORIGINS=

# Environment (development, staging, production)
ENVIRONMENT=

# For development/testing only - allow less strict validation
DEVELOPMENT_MODE=
