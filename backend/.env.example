AUTH0_DOMAIN=
AUTH0_API_AUDIENCE=
AUTH0_ISSUER=

AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_MGMT_AUDIENCE=

# Database
DATABASE_URL=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=

# Frontend URL for redirects after logout
FRONTEND_URL=

# Allowed CORS origins (comma-separated, no wildcards in production).
# For the Android Capacitor app (which serves bundled assets from https://localhost),
# CORS_ORIGINS must include https://localhost (e.g. CORS_ORIGINS=https://localhost,http://localhost:5173).
# Do NOT add capacitor://localhost (Capacitor 8 Android uses https scheme).
CORS_ORIGINS=

# Environment (development, staging, production)
ENVIRONMENT=

# For development/testing only - allow less strict validation
DEVELOPMENT_MODE=

# Evidence Storage (local | s3)
EVIDENCE_STORAGE=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ADDRESSING_STYLE=path
S3_PUBLIC_BASE_URL=
EVIDENCE_URL_TTL_SECONDS=
EVIDENCE_RETENTION_DAYS=

# Optional AI Worker Service (server-mode inference)
AI_WORKER_BASE_URL=
AI_WORKER_TIMEOUT_SECONDS=

# Sentry Error Tracking & Request Correlation
SENTRY_DSN=
SENTRY_TRACES_RATE=
LOG_HASH_SALT=

# Flight Recorder Event Retention (days)
EVENT_RETENTION_DAYS=30

# Optional Brevo Email Service (transactional notifications)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SmartProctor

